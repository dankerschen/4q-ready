rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FretWise: each signed-in person can read and write only their own progress document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 4th Quarter Ready: each signed-in person can read and write only their own training document.
    match /workouts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
